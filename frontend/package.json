{
  "name": "agenteval-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "gen:api": "openapi-typescript http://localhost:9000/openapi.json -o src/api/generated/schema.d.ts",
    "lint": "eslint src",
    "format": "prettier --write src",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "tsc --noEmit && eslint src && vitest run"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@tanstack/react-query": "^5.51.0",
    "antd": "^5.20.0",
    "axios": "^1.7.0",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "eslint": "^9.9.0",
    "jsdom": "^25.0.0",
    "openapi-typescript": "^7.3.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
